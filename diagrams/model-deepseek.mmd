flowchart TB
  IN["input_ids<br/>B × S"]:::input --> EMB["ParallelEmbedding<br/>→ B × S × 4096"]:::source
  EMB --> HCEXP["HC expand<br/>B × S × 4096 → B × S × 4 × 4096"]:::source

  subgraph MAIN["Main Block × 43 · explicit attention and FFN mHC sequence"]
    direction TB
    H4["block input<br/>B × S × 4 × 4096"]:::source
    APRE["hc_pre for attention<br/>4 → 1 · comb matrix 4 × 4"]:::source
    ASINK["comb Sinkhorn normalization<br/>20 iterations"]:::source
    ANORM["attention RMSNorm"]:::source
    H4 --> APRE --> ASINK --> ANORM

    subgraph ATT["Compressed Sparse Attention"]
      direction LR
      Q["Q LoRA<br/>4096 → 1024 → 64×512"]:::source
      KV["single MQA K/V projection<br/>4096 → 512"]:::source
      ROPE["RoPE on final 64 dims"]:::source
      TYPES["layer mix<br/>2× ratio 0 · 21× ratio 4 · 20× ratio 128"]:::source
      C4["ratio 4: overlap compressor<br/>Indexer top-512"]:::source
      C128["ratio 128: non-overlap compressor<br/>use compressed history"]:::source
      CORE["window 128 + selected history<br/>64 Q heads × 512"]:::source
      AOUT["de-RoPE tail + low-rank output<br/>→ 4096"]:::source
      Q --> ROPE --> CORE --> AOUT
      KV --> ROPE
      TYPES --> C4 --> CORE
      TYPES --> C128 --> CORE
    end
    ANORM --> Q
    ANORM --> KV
    ANORM --> TYPES
    AOUT --> APOST["hc_post for attention<br/>1 → 4 · mix output + 4 residuals"]:::source
    H4 -. "4 residual streams" .-> APOST
    APOST --> FPRE["hc_pre for FFN<br/>4 → 1 · comb matrix 4 × 4"]:::source
    FPRE --> FSINK["comb Sinkhorn normalization<br/>20 iterations"]:::source
    FSINK --> FNORM["FFN RMSNorm"]:::source

    subgraph MOE["MoE FFN in every block"]
      direction LR
      ROUTE["sqrtsoftplus router<br/>256 experts · top-6"]:::source
      EXPERT["routed experts<br/>FP4 is an inference format"]:::source
      SHARED["1 shared expert"]:::source
      SUM["routed + shared"]:::source
      ROUTE --> EXPERT --> SUM
      SHARED --> SUM
    end
    FNORM --> ROUTE
    FNORM --> SHARED
    SUM --> FPOST["hc_post for FFN<br/>1 → 4 · next block input"]:::source
    APOST -. "4 residual streams" .-> FPOST
  end

  HCEXP --> H4
  FPOST --> HHEAD["hc_head 4 → 1<br/>sigmoid, not Sinkhorn"]:::source --> NORM["Final RMSNorm"]:::source --> HEAD["Parallel lm_head"]:::output

  subgraph DSPARK["DSpark · three evidence entries, not a sequential path"]
    direction LR
    HF["HF config<br/>next-n layers = 1"]:::config
    INF["inference snapshot<br/>3 blocks · block size 5 · inject 40–42"]:::config
    DRAFT["inference draft path<br/>real token + 4 noise tokens<br/>attention + Markov + confidence"]:::source
    VLLM["vLLM example<br/>7 speculative tokens"]:::deploy
    BOUND["version / entry boundary"]:::note
    INF --> DRAFT
    HF -. "separate evidence" .-> BOUND
    DRAFT -. "separate evidence" .-> BOUND
    VLLM -. "deployment parameter" .-> BOUND
  end
  BOUND -.-> HEAD

  CACHE["reference: BF16 preallocated core / Indexer buffers<br/>+ FP32 compressor states"]:::state -.-> CORE
  QUANT["deployment subtotal: FP8 core + raw FP4 Indexer<br/>scale / metadata / packing not counted"]:::deploy -.-> CACHE

  classDef input fill:#223146,stroke:#83b7ff,color:#f4f7fa;
  classDef source fill:#17343a,stroke:#66d5c2,color:#f4f7fa;
  classDef state fill:#352c43,stroke:#d5aaff,color:#faf5ff;
  classDef output fill:#27324b,stroke:#83b7ff,color:#f4f7fa;
  classDef config fill:#263856,stroke:#83b7ff,color:#f4f7fa;
  classDef deploy fill:#3d3425,stroke:#ffb86b,color:#fff9ec,stroke-dasharray:5 4;
  classDef note fill:#263856,stroke:#83b7ff,color:#f4f7fa;
