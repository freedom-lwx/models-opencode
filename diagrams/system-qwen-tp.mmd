flowchart TB
  H["hidden<br/>B × S × 5120"]:::input --> GROUP["repeating layer group ×16<br/>linear · linear · linear · full"]:::source

  subgraph LINEAR["Gated DeltaNet lanes · 48 layers"]
    direction LR
    LPROJ["combined QKV + gates<br/>runtime TP plan"]:::source --> LCONV["Conv1d state"]:::state --> LREC["FP32 recurrent state<br/>48 heads × 128 × 128"]:::state --> LOUT["output projection"]:::source
  end

  subgraph FULL["Gated GQA lanes · 16 layers"]
    direction LR
    Q["24 Q heads × 256"]:::source --> GQA["GQA attention"]:::source --> OP["o_proj 6144 → 5120"]:::source
    KV["4 KV heads × 256<br/>growing KV cache"]:::state --> GQA
  end

  GROUP --> LINEAR
  GROUP --> FULL
  LOUT --> MLP["SwiGLU + residual"]:::source
  OP --> MLP
  MLP --> OUT["B × S × 5120"]:::output

  TP["Transformers TP plan mixes colwise,<br/>rowwise and gathered projections"]:::deploy -.-> LINEAR
  TP -.-> FULL
  NOFIXED["do not infer a fixed 24-head-per-GPU layout<br/>or a single unconditional AllReduce"]:::warn -.-> TP
  STATE_SUM["reference state includes GQA KV<br/>+ recurrent + convolution states"]:::note -.-> OUT

