flowchart LR
  REQ["Request<br/>token ids"]:::input --> PREFILL["Prefill pool<br/>build cache / state"]:::source
  PREFILL --> MANIFEST["transfer manifest<br/>named cache + recurrent + conv states"]:::state
  MANIFEST --> DECODE["Decode pool<br/>one or more new tokens"]:::source
  DECODE --> LOGITS["logits / sampled token"]:::output

  subgraph PARALLEL["Runtime parallel boundaries · deployment assumptions"]
    direction TB
    TP1["TP rank"]:::deploy <--> TP2["TP rank"]:::deploy
    ROUTER["MoE router"]:::deploy --> REMOTE["remote expert shard"]:::deploy --> COMBINE["weighted combine"]:::deploy
    NETWORK["network boundary<br/>bandwidth + efficiency + topology"]:::deploy
    TP1 -. "collective" .-> NETWORK
    ROUTER -. "dispatch" .-> NETWORK
    NETWORK -. "combine" .-> COMBINE
  end

  PREFILL -.-> PARALLEL
  DECODE -.-> PARALLEL
  FORMULA["communication labels are payload formulas<br/>not fixed wire time or benchmark latency"]:::note -.-> NETWORK

